---
import { I18N, PROJECTS, CATS, GH, type Lang } from "@/data/content";
import { emblem } from "@/lib/emblem";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = I18N[lang];

const count = (id: string) =>
  id === "all" ? PROJECTS.length : PROJECTS.filter((p) => p.cat === id).length;
---

<section
  id="work"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)] scroll-mt-24"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2">01</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-3">{t.work_title}</h3>
    <p class="text-[var(--white-icon)] max-w-2xl mb-8">{t.work_note}</p>

    <div class="flex flex-wrap gap-2 mb-8" id="work-filters">
      {
        CATS.map((cat) => (
          <button
            type="button"
            data-filter={cat.id}
            class:list={[
              "text-xs md:text-sm rounded-full px-4 py-2 border transition duration-300",
              cat.id === "all"
                ? "border-[var(--sec)] text-[var(--sec)]"
                : "border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-white hover:border-[#ffffff30]",
            ]}
          >
            {cat[lang]}
            <sup class="opacity-60 ml-1">{count(cat.id)}</sup>
          </button>
        ))
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="work-grid">
      {
        PROJECTS.map((project, i) => (
          <article
            class="group rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] overflow-hidden flex flex-col"
            data-cat={project.cat}
          >
            <div class="relative h-44 md:h-52 overflow-hidden bg-[#0d0d0d]">
              {project.image ? (
                <img
                  src={project.image}
                  alt={project.name}
                  loading="lazy"
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="size-28 text-[var(--sec)] opacity-80 group-hover:rotate-90 transition-transform duration-700">
                    <Fragment set:html={emblem(project.repo)} />
                  </div>
                </div>
              )}

              <span class="absolute top-3 left-3 text-[11px] tracking-widest text-[var(--white-icon)]">
                {String(i + 1).padStart(2, "0")}
              </span>

              {project.live && (
                <span class="absolute top-3 right-3 text-[10px] tracking-widest uppercase text-[var(--sec)] border border-[var(--sec)] rounded-full px-2 py-1">
                  {t.live}
                </span>
              )}
            </div>

            <div class="p-5 flex flex-col flex-grow">
              <div class="flex items-start justify-between gap-3">
                <h4 class="text-xl font-semibold leading-tight">{project.name}</h4>
                <span class="text-xs text-[var(--white-icon)] pt-1">{project.year}</span>
              </div>

              <p class="text-sm text-[var(--white-icon)] leading-relaxed mt-2 mb-4">
                {project[lang]}
              </p>

              <div class="mt-auto flex items-center justify-between gap-3">
                <span class="text-[11px] tracking-wide text-[var(--white-icon)]">
                  {project.tags.join(" · ")}
                  {project.team && ` · ${t.team}`}
                </span>

                <span class="flex gap-2 shrink-0">
                  <a
                    href={GH + project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.name} — GitHub`}
                    class="size-10 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition border border-[var(--white-icon-tr)] rounded-xl hover:bg-[var(--white-icon-tr)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-5"
                    >
                      <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                    </svg>
                  </a>

                  {project.live && (
                    <a
                      href={project.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${project.name} — ${t.live}`}
                      class="size-10 flex justify-center items-center text-[var(--sec)] hover:text-white transition border border-[var(--white-icon-tr)] rounded-xl hover:bg-[var(--white-icon-tr)]"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="size-5"
                      >
                        <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                      </svg>
                    </a>
                  )}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p
      id="work-empty"
      class="hidden text-center text-[var(--white-icon)] py-10 text-sm"
    >
      {t.work_empty}
    </p>

    <a
      href="https://github.com/krcgoktug"
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-[1.02]"
    >
      <span class="md:text-lg text-md">{t.work_all}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>

<script>
  const filters = document.getElementById("work-filters");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("#work-grid [data-cat]"),
  );
  const empty = document.getElementById("work-empty");

  filters?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "button[data-filter]",
    );
    if (!button) return;

    const want = button.dataset.filter;
    let shown = 0;

    cards.forEach((card) => {
      const on = want === "all" || card.dataset.cat === want;
      card.classList.toggle("hidden", !on);
      if (on) shown++;
    });

    filters.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
      const active = b === button;
      b.classList.toggle("border-[var(--sec)]", active);
      b.classList.toggle("text-[var(--sec)]", active);
      b.classList.toggle("border-[var(--white-icon-tr)]", !active);
      b.classList.toggle("text-[var(--white-icon)]", !active);
    });

    empty?.classList.toggle("hidden", shown !== 0);
  });
</script>
