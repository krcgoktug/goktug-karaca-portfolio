---
import { I18N, SPEC, type Lang } from "@/data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = I18N[lang];
---

<section
  id="stack"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)] scroll-mt-24"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2">05</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-3">{t.stack_title}</h3>
    <p class="text-[var(--white-icon)] max-w-2xl mb-8">{t.stack_note}</p>

    <div class="border-t border-[#ffffff10]">
      {
        SPEC.map((row) => (
          <div class="grid md:grid-cols-[minmax(0,0.3fr)_minmax(0,1fr)] gap-3 md:gap-8 py-5 border-b border-[#ffffff10]">
            <span class="text-[11px] tracking-widest uppercase text-[var(--sec)] md:pt-2">
              {lang === "tr" ? row.key_tr : row.key_en}
            </span>
            <div class="flex flex-wrap gap-2">
              {((lang === "tr" && row.items_tr) || row.items).map((item) => (
                <span class="text-sm text-[var(--white)] border border-[var(--white-icon-tr)] bg-[#1414149c] rounded-lg px-3 py-1.5 hover:border-[var(--sec)] hover:text-[var(--sec)] transition duration-300">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
