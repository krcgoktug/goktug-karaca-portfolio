---
import { I18N, INTERESTS, PROJECTS, GH, type Lang } from "@/data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = I18N[lang];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/krcgoktug",
    path: "M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/goktugkaraca/",
    path: "M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z",
  },
  {
    label: "Email",
    href: "mailto:karacagoktug73@gmail.com",
    path: "M3 3H21C21.5523 3 22 3.44772 22 4V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3ZM20 7.23792L12.0718 14.338L4 7.21594V19H20V7.23792ZM4.51146 5L12.0619 11.662L19.501 5H4.51146Z",
  },
];

/* the newest thing in the index, so the hero always points at live work */
const latest = PROJECTS[0];

/* under the portrait: the questions a recruiter asks in the first ten seconds */
const facts = [
  { k: t.fact_based, v: "İstanbul, TR" },
  { k: t.fact_now, v: t.fact_now_v },
  { k: t.fact_focus, v: t.fact_focus_v },
  { k: t.fact_langs, v: t.fact_langs_v },
];
---

<section id="home" class="text-[var(--white)] mt-16 md:mt-0">
  <div class="max-w-5xl mx-auto md:pt-32 md:pb-16 pb-12">
    <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[1.35fr_0.65fr] gap-10 lg:gap-12 items-start">
      <div class="space-y-5">
        <p class="text-sm md:text-base text-[var(--white-icon)]">
          {t.hero_meta}
        </p>

        <h1
          class="text-[var(--white)] text-5xl md:text-7xl font-semibold leading-[0.95] tracking-tight"
        >
          Göktuğ <br />
          <span class="text-[var(--sec)]">Karaca</span>
        </h1>

        <p class="text-md md:text-xl text-[var(--white-icon)] max-w-xl">
          {t.hero_lede}
        </p>


        <ul class="flex flex-wrap items-center gap-x-3 gap-y-2 pt-1">
          {
            INTERESTS.map((item, i) => (
              <li class="flex items-center gap-3 text-xs md:text-sm text-[var(--white)]">
                {item[lang]}
                {i < INTERESTS.length - 1 && (
                  <span class="w-1 h-1 rounded-full bg-[var(--sec)]" />
                )}
              </li>
            ))
          }
        </ul>

        <div class="flex flex-wrap items-center gap-2 pt-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith("mailto") ? undefined : "_blank"}
                rel="noopener noreferrer"
                aria-label={s.label}
                class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-7"
                >
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
          <a
            href="/resume"
            class="ml-1 text-sm text-[var(--white-icon)] hover:text-white transition border border-[var(--white-icon-tr)] bg-[#1414149c] hover:bg-[var(--white-icon-tr)] rounded-xl px-4 py-[0.9rem]"
            >{t.nav_resume}</a
          >
        </div>

        <a
          href={GH + latest.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-2 flex items-center gap-4 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] px-4 py-3 hover:border-[#ffffff26] transition-colors"
        >
          <span class="text-[10px] tracking-widest uppercase text-[var(--sec)] shrink-0">
            {lang === "tr" ? "En son" : "Latest"}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium truncate">{latest.name}</span>
            <span class="block text-xs text-[var(--white-icon)] truncate">
              {latest.tags.join(" · ")}
            </span>
          </span>
          <span
            class="text-[var(--white-icon)] group-hover:text-[var(--sec)] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform shrink-0"
            >↗</span
          >
        </a>
      </div>

      <div class="space-y-4">
        <figure class="relative">
          <div
            class="rounded-2xl overflow-hidden border border-[var(--white-icon-tr)] bg-[#1414149c]"
          >
            <img
              src="/assets/profile-photo.jpg"
              alt="Göktuğ Karaca"
              width="720"
              height="960"
              class="w-full aspect-[4/5] max-h-[340px] lg:max-h-none object-cover object-[50%_30%] grayscale hover:grayscale-0 transition-all duration-700"
            />
          </div>
          <figcaption
            class="mt-2 flex justify-between gap-2 text-[11px] tracking-widest uppercase text-[var(--white-icon)]"
          >
            <span>Fig. 01</span><span class="truncate">{t.plate_caption}</span>
          </figcaption>
        </figure>

        <dl
          class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] divide-y divide-[#ffffff10] overflow-hidden"
        >
          {
            facts.map((f) => (
              <div class="px-4 py-3">
                <dt class="text-[10px] tracking-widest uppercase text-[var(--white-icon)]">
                  {f.k}
                </dt>
                <dd class="text-sm mt-0.5">{f.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

