---
import { I18N, type Lang } from "@/data/content";
import LetterGlitch from "@/React/LetterGlitch.tsx";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = I18N[lang];
---

<section
  id="profile"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)] scroll-mt-24"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2">02</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-3">{t.profile_title}</h3>
    <p class="text-[var(--white-icon)] max-w-2xl mb-8">{t.profile_note}</p>

    <div class="grid lg:grid-cols-[1.35fr_0.65fr] gap-8 items-stretch">
      <div class="space-y-4 text-[var(--white-icon)] leading-relaxed">
        <p>{t.profile_p1}</p>
        <p>{t.profile_p2}</p>
        <p>{t.profile_p3}</p>
      </div>

      <div
        class="min-h-[260px] rounded-2xl overflow-hidden border border-[var(--white-icon-tr)]"
      >
        <LetterGlitch
          client:visible
          glitchColors={["#272727", "#ff5c2b", "#4a2d1d"]}
          glitchSpeed={60}
          centerVignette={true}
          outerVignette={false}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>
