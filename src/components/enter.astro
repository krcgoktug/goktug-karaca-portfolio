---
import { I18N, type Lang } from "@/data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = I18N[lang];
/* the laptop shows the page in the language you are reading */
const embedSrc = lang === "tr" ? "/tr/?embed=1" : "/?embed=1";
---

<div class="enter" id="enter" data-embed={embedSrc} hidden aria-hidden="true">
  <div class="enter-stage" id="enterStage">
    <div class="enter-drift" id="enterDrift">
      <div class="photo" id="enterPhoto">
        <img src="/assets/desk.jpg" alt="" width="2000" height="1333" fetchpriority="high" />

        <div class="screen" id="enterScreen">
          <iframe id="enterFrame" src="about:blank" title="" tabindex="-1" scrolling="no"></iframe>
          <span class="power"></span>
          <span class="flash"></span>
          <span class="glass"></span>
        </div>

        <span class="invite" id="enterInvite"></span>

        <span class="point-label">{t.enter_cta}</span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* --- the arrival: our site running on a real laptop you click into ------- */

  .enter {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #07070a;
    cursor: pointer;
  }

  .enter[hidden] {
    display: none;
  }

  .enter.done {
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms linear;
  }

  .enter-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: 0 0;
    will-change: transform;
    transition: transform 1150ms cubic-bezier(0.66, 0, 0.2, 1);
  }

  /* the shot breathes while it waits, and the click continues that same move
     instead of starting a new one */
  /* the centring offset lives here so the stage transform stays free for the
     camera move the script applies on the click */
  .enter-drift {
    transform: translate(-50%, -50%);
    transform-origin: 52% 46%;
    animation: enterDrift 26s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes enterDrift {
    from {
      transform: translate(-50%, -50%) scale(1);
    }
    to {
      transform: translate(-50%, -50%) scale(1.045) translate3d(-10px, -7px, 0);
    }
  }

  /* the photo covers the viewport, and everything that has to sit on the
     laptop is positioned as a fraction of it, so it never drifts */
  .enter .photo {
    position: relative;
    width: max(100vw, calc(100vh * 1.5));
    height: max(100vh, calc(100vw / 1.5));
  }

  @media (max-width: 759px) {
    .enter .photo {
      width: 172vw;
      height: calc(172vw / 1.5);
    }
  }

  .enter .photo > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      opacity 500ms linear,
      filter 420ms ease-out;
  }

  .enter .screen {
    position: absolute;
    overflow: hidden;
    background: #040406;
  }

  .enter .screen iframe {
    position: absolute;
    top: 0;
    left: 0;
    border: 0;
    transform-origin: 0 0;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 420ms linear 120ms,
      filter 900ms cubic-bezier(0.16, 1, 0.3, 1);
    filter: brightness(0.82) contrast(1.04);
  }

  .enter.lit .screen iframe {
    opacity: 1;
  }

  /* the panel itself invites the click — no sticker arrow over the photograph.
     the glow is its own layer so the pulse never repaints the iframe under it */
  .enter .invite {
    position: absolute;
    pointer-events: none;
    box-shadow: 0 0 52px 12px rgba(190, 205, 255, 0.17);
    opacity: 0;
    will-change: opacity;
  }

  .enter.lit .invite {
    animation: enterInvite 3.6s ease-in-out infinite;
  }

  @keyframes enterInvite {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  .enter .power {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: rgba(255, 255, 255, 0.85);
    transform: scaleX(0.02);
    opacity: 0;
  }

  .enter.lit .power {
    animation: enterPowerOn 560ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes enterPowerOn {
    0% {
      opacity: 1;
      transform: scaleX(0.02) scaleY(1);
    }
    45% {
      opacity: 1;
      transform: scaleX(1) scaleY(1);
    }
    100% {
      opacity: 0;
      transform: scaleX(1) scaleY(60);
    }
  }

  /* the display catching the light as it wakes under your click */
  .enter .flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .enter.go .flash {
    animation: enterFlash 420ms ease-out forwards;
  }

  @keyframes enterFlash {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 0.3;
    }
    100% {
      opacity: 0;
    }
  }

  .enter .glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      112deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 26%,
      transparent 48%,
      transparent 72%,
      rgba(255, 214, 170, 0.06) 100%
    );
    transition: opacity 500ms linear;
  }

  /* a line of lamp-lit type on the desk, rather than an overlay */
  .enter .point-label {
    position: absolute;
    left: 50%;
    top: 93%;
    transform: translate(-50%, -50%);
    font-size: clamp(0.62rem, 0.85vw, 0.78rem);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: #ffbe8a;
    opacity: 0;
    white-space: nowrap;
    text-shadow: 0 0 18px rgba(255, 170, 90, 0.35);
    animation: enterLabelIn 2.4s ease-in-out 1100ms infinite;
  }

  @keyframes enterLabelIn {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.85;
    }
  }

  /* walking in: the room falls back, the screen takes the frame */
  .enter.go {
    cursor: default;
  }

  .enter.go .enter-drift {
    animation-play-state: paused;
  }

  .enter.go .invite {
    opacity: 0;
    animation: none;
    transition: opacity 200ms linear;
  }

  .enter.go .screen iframe {
    filter: none;
  }

  /* focus pull: the room dims as the camera moves into the display */
  .enter.go .photo > img {
    filter: brightness(0.45);
    opacity: 0;
    transition:
      filter 420ms ease-out,
      opacity 700ms linear 300ms;
  }

  .enter.go .point-label,
  .enter.go .glass {
    opacity: 0;
    transition: opacity 240ms linear;
    animation: none;
  }

  /* the lamp follows you into the page for a moment, so the room and the site
     are not two unrelated worlds */
  .enter-afterglow {
    position: fixed;
    inset: 0;
    z-index: 300;
    pointer-events: none;
    background: radial-gradient(
      58% 46% at 80% -4%,
      rgba(255, 186, 110, 0.26),
      rgba(255, 150, 70, 0.08) 42%,
      transparent 72%
    );
    animation: enterAfterglow 1600ms ease-out forwards;
  }

  @keyframes enterAfterglow {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  html.locked body {
    overflow: hidden;
  }

  /* the copy of the site living inside the laptop */
  html.embed body {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .enter-drift,
    .enter .point-label,
    .enter.lit .invite {
      animation: none;
    }
    .enter .point-label {
      opacity: 0.8;
    }
  }
</style>

<script>
  const box = document.getElementById("enter");

  if (box) {
    const params = new URLSearchParams(location.search);
    const root = document.documentElement;
    const embedded =
      (() => {
        try {
          return window.self !== window.top;
        } catch (e) {
          return true;
        }
      })() || params.has("embed");

    if (embedded) root.classList.add("embed");

    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tooSmall = window.innerHeight < 430 || window.innerWidth < 320;
    const forced = params.has("intro");

    let visited = false;
    try {
      visited = sessionStorage.getItem("gk-visited") === "1";
      localStorage.removeItem("gk-visited"); /* flag left by an earlier build */
    } catch (e) {}

    const skip = embedded || still || tooSmall || location.hash || (visited && !forced);

    if (!skip) {
      const stage = document.getElementById("enterStage") as HTMLElement;
      const drift = document.getElementById("enterDrift") as HTMLElement;
      const photo = document.getElementById("enterPhoto") as HTMLElement;
      const screenEl = document.getElementById("enterScreen") as HTMLElement;
      const frame = document.getElementById("enterFrame") as HTMLIFrameElement;
      const img = photo.querySelector("img") as HTMLImageElement;

      /* where the laptop's panel sits inside the photograph */
      const PANEL = { x: 0.2952, y: 0.2772, w: 0.3826, h: 0.3639 };
      /* a phone cannot land 1:1 on a landscape panel, so there it keeps the
         panel's own shape, shows the desktop layout a laptop would show, and
         hands over with a cross-fade instead */
      const narrow = window.innerWidth < 760;
      const EMBED_W = 1280;
      const EMBED_H = 800;

      const fit = () => {
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        /* layout box, not the drifting on-screen rect */
        const pw = photo.offsetWidth;
        const ph = photo.offsetHeight;

        let w = PANEL.w * pw;
        let h = PANEL.h * ph;
        let x = PANEL.x * pw;
        let y = PANEL.y * ph;

        if (!narrow) {
          const va = vw / vh;
          if (w / h > va) {
            const nw = h * va;
            x += (w - nw) / 2;
            w = nw;
          } else {
            const nh = w / va;
            y += (h - nh) / 2;
            h = nh;
          }
        }

        screenEl.style.left = x + "px";
        screenEl.style.top = y + "px";
        screenEl.style.width = w + "px";
        screenEl.style.height = h + "px";

        const invite = document.getElementById("enterInvite");
        if (invite) {
          invite.style.left = x + "px";
          invite.style.top = y + "px";
          invite.style.width = w + "px";
          invite.style.height = h + "px";
        }

        const fw = narrow ? EMBED_W : vw;
        const fh = narrow ? EMBED_H : vh;
        frame.style.width = fw + "px";
        frame.style.height = fh + "px";
        frame.style.transform = "scale(" + (w / fw).toFixed(5) + ")";
      };

      box.hidden = false;
      box.setAttribute("aria-hidden", "false");
      root.classList.add("locked");
      fit();
      window.addEventListener("resize", fit);

      /* the room is painted first; only then does the laptop start loading */
      const loadScreen = () => {
        if (frame.src.endsWith("blank")) frame.src = box.dataset.embed || "/?embed=1";
      };
      if (img.complete) loadScreen();
      else img.addEventListener("load", loadScreen, { once: true });
      setTimeout(loadScreen, 1800);

      /* the screen wakes once the page inside it has loaded, then drifts
         slowly down the page so it reads as something being browsed */
      let liveTimer = 0;
      let liveFrom = 0;
      let liveReach = -1;
      const liveStart = () => {
        const begin = performance.now();
        /* measured once, then nudged a few times a second: reading scrollHeight
           every frame forces layout inside the iframe and janks the whole page */
        liveTimer = window.setInterval(() => {
          try {
            const win = frame.contentWindow;
            if (!win) return;
            if (liveReach < 0) {
              const page = win.document.documentElement.scrollHeight || 0;
              const view = narrow ? EMBED_H : window.innerHeight;
              liveReach = Math.min(460, Math.max(0, page - view));
            }
            const phase = (performance.now() - begin) / 46000;
            liveFrom = (liveReach * (1 - Math.cos(phase * Math.PI * 2))) / 2;
            win.scrollTo({ top: liveFrom, behavior: "instant" });
          } catch (e) {}
        }, 120);
      };

      const lightUp = () => {
        if (box.classList.contains("lit")) return;
        box.classList.add("lit");
        if (!still) liveStart();
      };
      frame.addEventListener("load", lightUp);
      setTimeout(lightUp, 2600);

      let walked = false;
      const walkIn = () => {
        if (walked) return;
        walked = true;
        try {
          sessionStorage.setItem("gk-visited", "1");
        } catch (e) {}

        /* bring the copy on the laptop back to the top, so it matches the page
           it is about to become */
        clearInterval(liveTimer);
        const scrollBegin = performance.now();
        const from = liveFrom;
        const settle = (now: number) => {
          const p = Math.min((now - scrollBegin) / 520, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          try {
            frame.contentWindow?.scrollTo({ top: from * (1 - eased), behavior: "instant" });
          } catch (e) {}
          if (p < 1) requestAnimationFrame(settle);
        };
        requestAnimationFrame(settle);

        /* freeze the breathing shot before measuring, so the camera lands */
        drift.style.animationPlayState = "paused";

        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const st = stage.getBoundingClientRect();
        const sr = screenEl.getBoundingClientRect();
        const scale = narrow
          ? Math.max(vw / sr.width, vh / sr.height)
          : vw / sr.width;
        const tx = -st.left - scale * (sr.left - st.left);
        const ty = -st.top - scale * (sr.top - st.top);

        box.classList.add("go");
        stage.style.transform =
          "translate(" + tx.toFixed(1) + "px," + ty.toFixed(1) + "px) scale(" +
          scale.toFixed(5) + ")";

        /* cross-fade only once the zoom has landed, so the copy on the laptop
           and the real page are pixel-identical while both are visible */
        setTimeout(() => {
          box.classList.add("done");
          root.classList.remove("locked");

          const glow = document.createElement("div");
          glow.className = "enter-afterglow";
          document.body.appendChild(glow);
          setTimeout(() => glow.remove(), 1700);

          setTimeout(() => {
            box.hidden = true;
            frame.src = "about:blank";
            window.removeEventListener("resize", fit);
          }, 320);
        }, 1220);
      };

      box.addEventListener("pointerdown", walkIn);
      box.addEventListener("click", walkIn);
      document.addEventListener("keydown", (e) => {
        if (walked || box.hidden) return;
        if (e.key === "Enter" || e.key === " " || e.key === "Escape") {
          e.preventDefault();
          walkIn();
        }
      });
    }
  }
</script>
