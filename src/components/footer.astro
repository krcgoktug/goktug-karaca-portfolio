---
import { I18N, type Lang } from "@/data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = I18N[lang];
const year = new Date().getFullYear();
---

<footer class="text-[var(--white-icon)] pb-28 md:pb-12 pt-10">
  <div class="max-w-5xl mx-auto">
    <!-- drawn as SVG with textLength, so the full name fits the column at any
         width instead of being clipped by the container -->
    <svg
      class="w-full block"
      viewBox="0 0 1000 140"
      role="img"
      aria-label="Göktuğ Karaca"
    >
      <text
        x="0"
        y="118"
        textLength="1000"
        lengthAdjust="spacingAndGlyphs"
        font-size="120"
        font-weight="600"
        fill="none"
        stroke="#ffffff1f"
        stroke-width="1"
      >
        GÖKTUĞ KARACA
      </text>
    </svg>

    <div
      class="flex flex-wrap justify-between items-center gap-3 text-[11px] tracking-widest uppercase border-t border-[#ffffff10] mt-6 pt-5"
    >
      <span>© {year} Göktuğ Karaca</span>
      <span class="hidden md:inline">{t.foot_built}</span>
      <a href="#home" class="hover:text-[var(--sec)] transition-colors">
        {lang === "tr" ? "Başa dön ↑" : "Back to top ↑"}
      </a>
    </div>
  </div>
</footer>
