---
import { I18N, type Lang } from "@/data/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = I18N[lang];
const site = "https://www.goktugkaraca.com";
const path = lang === "tr" ? "/tr/" : "/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <meta name="author" content="Göktuğ Karaca" />
    <meta name="theme-color" content="#101010" />

    <link rel="icon" type="image/svg+xml" href="/assets/gk-favicon.svg" />
    <link rel="canonical" href={site + path} />
    <link rel="alternate" hreflang="en" href={site + "/"} />
    <link rel="alternate" hreflang="tr" href={site + "/tr/"} />
    <link rel="alternate" hreflang="x-default" href={site + "/"} />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-ext-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.desc} />
    <meta property="og:url" content={site + path} />
    <meta property="og:image" content={site + "/assets/profile-photo.jpg"} />
    <meta property="og:site_name" content="Göktuğ Karaca" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Göktuğ Karaca",
      url: "https://www.goktugkaraca.com",
      image: "https://www.goktugkaraca.com/assets/profile-photo.jpg",
      sameAs: [
        "https://github.com/krcgoktug",
        "https://www.linkedin.com/in/g%C3%B6ktu%C4%9F-karaca-921479249/",
      ],
      jobTitle: "Computer Engineering Student",
      email: "mailto:karacagoktug73@gmail.com",
      address: { "@type": "PostalAddress", addressLocality: "İstanbul", addressCountry: "TR" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Fenerbahçe University" },
    })} />
  </head>

  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  /* latin-ext carries ğ ş ı İ Ğ Ş — without it Turkish falls back mid-word */
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-ext-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
      U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
      U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F,
      U+A720-A7FF;
  }

  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
      U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
      U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --background: #101010;
    --component-bg: #14141480;
    /* the one signal colour, carried over from the previous build */
    --sec: #ff5c2b;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  html {
    scroll-behavior: smooth;
    /* the copy inside the laptop is nudged a few times a second; smooth
       scrolling would restart an animation on every nudge and never settle */
    scrollbar-gutter: stable;
  }

  html.embed {
    scroll-behavior: auto;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  :focus-visible {
    outline: 2px solid var(--sec);
    outline-offset: 3px;
  }

  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    background: #ffffff18;
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #ffffff28;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #ffffff18 var(--background);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
